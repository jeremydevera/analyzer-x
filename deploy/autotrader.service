[Unit]
Description=MEXC auto-trader (strategy runner)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__REPO__
ExecStart=__REPO__/.venv/bin/python -m tradingagents.auto_trader run
Restart=always
RestartSec=10
# Live/dry follows the saved settings (Auto Trade / Dry run checkboxes).
# Uncomment to force simulation regardless of settings:
#Environment=AUTO_TRADE_DRY=yes

[Install]
WantedBy=multi-user.target
